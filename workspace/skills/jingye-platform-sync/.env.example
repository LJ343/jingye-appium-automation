# 平台配置
JINGYE_PLATFORM_BASE_URL=https://smartecosystem.xibuzhilian.com
JINGYE_EXTERNAL_API_KEY=replace-with-api-key
JINGYE_SOURCE_SYSTEM=agent
JINGYE_PROJECT_NAME=敬业钢铁
JINGYE_SALES_LOADING_POINT_NAME=河北敬业钢铁
JINGYE_TEST_PLATFORM_BASE_URL=http://192.168.13.7:18100
JINGYE_TEST_PROJECT_NAME=612演示项目
JINGYE_TEST_DB_NAME=jingye_facts.test.sqlite3

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=replace-with-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=replace-with-bucket-name
OSS_URL_PREFIX=https://replace-with-bucket.oss-cn-beijing.aliyuncs.com
OSS_FILE_HOST=dcsz-wl/

# 敬业邮件收件人；支持逗号、分号或空格分隔多个地址
JINGYE_PLATFORM_EMAIL_TO=platform-ops@example.com
JINGYE_RECONCILIATION_EMAIL_TO=reconciliation@example.com

# DashScope / VLM 视觉兜底配置
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=https://replace-with-compatible-endpoint/compatible-mode/v1
RESULT_CHECK_MODEL_NAME=qwen3-vl-plus
VLM_IMAGE_MAX_SIDE=2200
VLM_RENDER_DPI=190
VLM_JPEG_QUALITY=92
VLM_MAX_PAGES=4
VLM_EXTRACTION_TEMPERATURE=0.1
VLM_MAX_TOKENS=1800
VLM_CONNECT_TIMEOUT_SECONDS=8
VLM_READ_TIMEOUT_SECONDS=120
VLM_REQUEST_RETRIES=3
AUDIT_MAX_WORKERS=8
